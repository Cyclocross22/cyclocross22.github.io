<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Unicon22 Cyclocross"
     xmlns="http://www.topografix.com/GPX/1/1"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata>
    <name>Rundkurs Schlosspark Steyr</name>
    <desc>Rundkurs fuer das Cyclocross der UNICON 22 im Schlosspark Steyr.
      Reine Runde, ~960 m, beginnt und endet an der Rundeneinfahrt am
      Nordrand (17 m westlich der Start/Ziel-Flagge). Verlauf nach der
      eingezeichneten Linie der Veranstalterin, inkl. Wiesen-Slalom am
      Nordrand (v12) und Wiesen-Kurve am Suedrand. Kreuzt keinen Zaun,
      keine Mauer, kein Gebaeude.</desc>
    <keywords>Cyclocross, UNICON 22, Steyr, Schlosspark, Rundkurs</keywords>
  </metadata>
  <wpt lat="48.041479" lon="14.417132">
    <name>Start / Ziel</name><desc>Flagge: Start der ersten, Ziel der letzten Runde</desc><sym>Flag</sym>
  </wpt>
  <wpt lat="48.041515" lon="14.416906">
    <name>Rundeneinfahrt</name><desc>Hier schliesst sich die Runde; Zeitnahme-Linie</desc><sym>Flag</sym>
  </wpt>
  <wpt lat="48.040394" lon="14.415200">
    <name>Kraftpark</name><desc>Schleife und Zickzack an den Geraeten</desc><sym>Park</sym>
  </wpt>
  <wpt lat="48.040284" lon="14.414686">
    <name>Spielplatz</name><desc>Zugang ums Zaunende; Finger, Wanne und Haarnadel</desc><sym>Park</sym>
  </wpt>
  <wpt lat="48.040263" lon="14.414170">
    <name>WC</name><desc>Scharfe Kehre am Klo/Kiesfeld</desc><sym>Restroom</sym>
  </wpt>
  <trk>
